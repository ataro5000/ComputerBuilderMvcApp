@*
------------------------------------------------------------------------------
ForgotPassword.cshtml
This Razor Page provides the UI for users to request a password reset. Users
enter their email address, and upon submission, the backend will process the
request and send a password reset link if the email is registered.
------------------------------------------------------------------------------
*@

@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1>@ViewData["Title"]</h1>
<h2>Enter your email.</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            @* Displays validation errors for the form *@
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                @* Input field for the user's email address *@
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            @* Button to submit the password reset request *@
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
        </form>
    </div>
</div>